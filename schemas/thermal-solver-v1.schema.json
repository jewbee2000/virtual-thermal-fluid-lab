{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed thermal solver version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "method", "rtol", "requested_rtol", "atol", "max_step_s", "effective_max_step_s", "state_order", "state_units"],
  "properties": {
    "version": {"const": 1},
    "method": {"enum": ["RK45", "DOP853", "Radau"]},
    "rtol": {"type": "number", "exclusiveMinimum": 0},
    "requested_rtol": {"type": "number", "exclusiveMinimum": 0},
    "atol": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "number", "exclusiveMinimum": 0}},
    "max_step_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
    "effective_max_step_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
    "state_order": {"const": ["wall_temperature_k", "hot_temperature_k", "cold_temperature_k", "pump_speed", "valve_opening", "heat_in_j", "heat_rejected_j"]},
    "state_units": {"const": ["K", "K", "K", "1", "1", "J", "J"]}
  }
}
